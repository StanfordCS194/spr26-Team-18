LEGISCAN_API_KEY=your_legiscan_api_key_here

# LLM gateway. Set one provider key; optionally force provider/model.
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OpenAI chat calls use Batch API by default; these control blocking waits.
# LLM_BATCH_TIMEOUT_SECONDS=86400
# LLM_BATCH_POLL_INTERVAL_SECONDS=10
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

LEGI_BILL_DB_PATH=~/.legi_bill/bills.db
